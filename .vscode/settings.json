{
	"cSpell.words": ["FBEE", "fbemitter", "pnpm", "Snyk"],
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.hg/store/**": true,
		"**/.progress/**": true,
		"**/node_modules/*/**": true,
		".github": true,
		"cjs": true,
		"coverage": true,
		"esm": true,
		"scripts": true
	},
	"typescript.tsdk": "node_modules/typescript/lib"
}
