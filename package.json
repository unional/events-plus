{
	"name": "@unional/events-plus",
	"version": "3.0.2",
	"description": "Provides additional features to event emitters",
	"homepage": "https://github.com/cyberuni/events-plus",
	"bugs": {
		"url": "https://github.com/cyberuni/events-plus/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/events-plus.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"import": "./esm/index.js",
		"require": "./cjs/index.js"
	},
	"main": "./cjs/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!*/trapErrorTest.*",
		"!**/*.spec.*",
		"!**/*.spec16.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:doc": "typedoc",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf cjs coverage docs esm",
		"coverage": "vitest run --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "run-p build coverage depcheck typecheck",
		"version": "changeset version",
		"watch": "vitest"
	},
	"dependencies": {
		"@just-func/types": "^0.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"@types/fbemitter": "^2.0.35",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"eventemitter2": "^6.4.9",
		"eventemitter3": "^5.0.4",
		"fbemitter": "^3.0.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"standard-log": "^12.1.2",
		"tsdown": "^0.22.14",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.20.0"
}
